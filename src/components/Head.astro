---
// Starlight's head plus: an x-default language link (English), breadcrumb
// structured data in the page's language, and the site analytics script.
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const locale = route.locale; // undefined for English (the root locale)
const home = `https://docs.gpuflow.app/${locale ? `${locale}/` : ''}`;
const path = Astro.url.pathname.replace(locale ? `/${locale}/` : '/', '/');
const englishUrl = `https://docs.gpuflow.app${path}`;

const crumbs = [
  { name: 'GPUFlow', url: 'https://gpuflow.app' },
  { name: route.siteTitle, url: home },
];
if (!route.entry.data.template || route.entry.data.template === 'doc') {
  crumbs.push({ name: route.entry.data.title, url: new URL(Astro.url.pathname, Astro.site).href });
}
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
};
---

<Default><slot /></Default>
<link rel="alternate" hreflang="x-default" href={englishUrl} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
<script src="https://anal.gpuflow.app/api/script.js" data-site-id="5cede7db7be6" defer></script>
